<Window x:Class="GrammarBubble.App.Windows.SnipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capturar texto"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross">
    <Canvas x:Name="Root" Background="Black"
            MouseLeftButtonDown="OnDown"
            MouseMove="OnMove"
            MouseLeftButtonUp="OnUp"
            MouseRightButtonDown="OnCancel">
        <Image x:Name="Shot" Stretch="Fill" />
        <Path x:Name="Dim" Fill="#8C000000" IsHitTestVisible="False" />
        <Border x:Name="Frame" BorderBrush="White" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False" />
        <TextBlock x:Name="SizeLabel" Foreground="White" Background="#99000000" Padding="4,2"
                   Visibility="Collapsed" IsHitTestVisible="False" />
    </Canvas>
</Window>
